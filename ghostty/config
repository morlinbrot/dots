font-size = 17
working-directory = ~/dots

theme = Catppuccin Mocha
font-family = IosevkaTerm Nerd Font Mono
macos-icon = holographic
cursor-style = bar
# Over SSH, install Ghostty's terminfo entry on the remote host (or fall back to xterm-256color).
shell-integration-features = ssh-terminfo

# Highlight outline around the currently focused pane.
custom-shader = ~/dots/ghostty/shaders/focus-pane.glsl
# Awesomest cursor animation.
custom-shader = ~/dots/ghostty/shaders/cursor_blaze.glsl

# Not using macos-option-as-alt to preserve being able to type special characters like ü means having to define explict key combos for common alt key combos.
# macos-option-as-alt = true
# Word movement/deletion
keybind = alt+backspace=text:\x1b\x7f
keybind = alt+b=esc:b
keybind = alt+f=esc:f
keybind = alt+d=esc:d
# Insert last arg of previous command (shell) / repeat last find (helix)
keybind = alt+.=esc:.
# Tab switching in Helix
keybind = alt+h=esc:h
keybind = alt+l=esc:l

keybind = global:ctrl+shift+t=toggle_quick_terminal

# Split essentials
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+'=new_split:down
keybind = ctrl+shift+n=goto_split:next
keybind = ctrl+shift+p=goto_split:previous
keybind = ctrl+shift+f=toggle_split_zoom

keybind = super+ctrl+shift+l=resize_split:right,10
keybind = super+ctrl+shift+h=resize_split:left,10
keybind = super+ctrl+shift+k=resize_split:up,10
keybind = super+ctrl+shift+j=resize_split:down,10
keybind = super+ctrl+shift+==equalize_splits

# Screen/scrollback manipulation
keybind = ctrl+shift+u=scroll_page_fractional:-0.5
keybind = ctrl+shift+d=scroll_page_fractional:0.5
keybind = ctrl+shift+k=jump_to_prompt:-1
keybind = ctrl+shift+j=jump_to_prompt:1

